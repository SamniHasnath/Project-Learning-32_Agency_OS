# Used by docker-compose.yml
POSTGRES_PASSWORD=change-me
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

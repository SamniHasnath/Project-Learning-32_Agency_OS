generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MEMBER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  LEAD
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  VOID
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum DocumentType {
  QUOTATION
  INVOICE
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CASH
  CHECK
  STRIPE
  PAYPAL
  OTHER
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

/// A tenant. Every business record belongs to exactly one agency.
model Agency {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  website   String?
  address   String?
  taxId     String?
  currency  String   @default("USD")
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  clients    Client[]
  projects   Project[]
  quotations Quotation[]
  invoices   Invoice[]
  payments   Payment[]
  templates  DocumentTemplate[]
  auditLogs  AuditLog[]

  @@map("agencies")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(OWNER)
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agencyId])
  @@map("users")
}

// ─── CRM ────────────────────────────────────────────────────────────────────

model Client {
  id        String       @id @default(uuid())
  agencyId  String
  agency    Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  name      String
  email     String
  phone     String?
  company   String?
  address   String?
  taxId     String?
  notes     String?
  status    ClientStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  projects   Project[]
  quotations Quotation[]
  invoices   Invoice[]

  @@unique([agencyId, email])
  @@index([agencyId])
  @@map("clients")
}

model Project {
  id          String        @id @default(uuid())
  agencyId    String
  agency      Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  name        String
  description String?
  status      ProjectStatus @default(IN_PROGRESS)
  budget      Decimal       @default(0) @db.Decimal(14, 2)
  startDate   DateTime?
  endDate     DateTime?
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  quotations Quotation[]
  invoices   Invoice[]

  @@index([agencyId])
  @@map("projects")
}

// ─── Templates ──────────────────────────────────────────────────────────────

/// Reusable, agency-owned layout + branding definition. Documents copy the
/// resolved template into `templateSnapshot` at issue time, so later edits to
/// a template never change an already issued document.
model DocumentTemplate {
  id        String       @id @default(uuid())
  agencyId  String
  agency    Agency       @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  name      String
  type      DocumentType
  isDefault Boolean      @default(false)
  /// { primaryColor, accentColor, fontFamily, showLogo }
  branding  Json
  /// { title, sections: [{ key, visible }], footerText }
  layout    Json
  version   Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  quotations Quotation[]
  invoices   Invoice[]

  @@index([agencyId, type])
  @@map("document_templates")
}

// ─── Commercial documents ───────────────────────────────────────────────────

model Quotation {
  id         String          @id @default(uuid())
  agencyId   String
  agency     Agency          @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  number     String
  title      String
  status     QuotationStatus @default(DRAFT)
  issueDate  DateTime        @default(now())
  expiryDate DateTime

  clientId   String
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId  String?
  project    Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  templateId String?
  template   DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  /// Frozen copies taken at creation and refreshed only while DRAFT.
  clientSnapshot   Json
  agencySnapshot   Json
  templateSnapshot Json

  subtotal       Decimal      @db.Decimal(14, 2)
  discountType   DiscountType @default(FIXED)
  discountValue  Decimal      @default(0) @db.Decimal(14, 2)
  discountAmount Decimal      @default(0) @db.Decimal(14, 2)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal      @default(0) @db.Decimal(14, 2)
  total          Decimal      @db.Decimal(14, 2)
  currency       String       @default("USD")

  notes String?
  terms String?

  sentAt     DateTime?
  acceptedAt DateTime?

  items   QuotationItem[]
  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, number])
  @@index([agencyId, status])
  @@index([agencyId, createdAt])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal   @db.Decimal(12, 3)
  unitPrice   Decimal   @db.Decimal(14, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)

  @@index([quotationId])
  @@map("quotation_items")
}

model Invoice {
  id        String        @id @default(uuid())
  agencyId  String
  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  number    String
  title     String
  status    InvoiceStatus @default(DRAFT)
  issueDate DateTime      @default(now())
  dueDate   DateTime

  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  templateId  String?
  template    DocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// One invoice per quotation — DB-level guard against duplicate conversion.
  quotationId String?           @unique
  quotation   Quotation?        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  /// Human reference, e.g. the source quotation number.
  reference   String?

  clientSnapshot   Json
  agencySnapshot   Json
  templateSnapshot Json

  subtotal          Decimal      @db.Decimal(14, 2)
  discountType      DiscountType @default(FIXED)
  discountValue     Decimal      @default(0) @db.Decimal(14, 2)
  discountAmount    Decimal      @default(0) @db.Decimal(14, 2)
  taxRate           Decimal      @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal      @default(0) @db.Decimal(14, 2)
  total             Decimal      @db.Decimal(14, 2)
  paidAmount        Decimal      @default(0) @db.Decimal(14, 2)
  outstandingAmount Decimal      @db.Decimal(14, 2)
  currency          String       @default("USD")

  notes String?
  terms String?

  sentAt DateTime?
  paidAt DateTime?

  items    InvoiceItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, number])
  @@index([agencyId, status, dueDate])
  @@index([agencyId, createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  lineTotal   Decimal @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id          String        @id @default(uuid())
  agencyId    String
  agency      Agency        @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  number      String
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount      Decimal       @db.Decimal(14, 2)
  method      PaymentMethod @default(BANK_TRANSFER)
  paymentDate DateTime      @default(now())
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())

  @@unique([agencyId, number])
  @@index([agencyId, createdAt])
  @@index([invoiceId])
  @@map("payments")
}

// ─── Infrastructure ─────────────────────────────────────────────────────────

/// Per-agency, per-type, per-year counter used by NumberingService.
/// Incremented with a single atomic UPSERT, so concurrent creates never
/// receive the same number.
model DocumentSequence {
  agencyId  String @map("agency_id")
  type      String
  year      Int
  lastValue Int    @map("last_value")

  @@id([agencyId, type, year])
  @@map("document_sequences")
}

model AuditLog {
  id        String   @id @default(uuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([agencyId, createdAt])
  @@map("audit_logs")
}

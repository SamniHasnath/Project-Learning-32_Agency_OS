# PostgreSQL connection string
DATABASE_URL="postgresql://agency_os:CHANGE_ME@localhost:5434/agency_os?schema=public"
# Separate database used by `npm run test:e2e` (it is wiped between runs)
TEST_DATABASE_URL="postgresql://agency_os:CHANGE_ME@localhost:5434/agency_os_test?schema=public"
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="7d"
# Comma-separated list of allowed browser origins
FRONTEND_URL="http://localhost:3000"
PORT=3001
